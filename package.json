{
  "name": "carenest-therapy",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon -r dotenv/config --experimental-json-modules src/index.js",
    "seed": "node -r dotenv/config src/scripts/seedDatabase.js",
    "docs:consolidate": "node src/docs/consolidate-docs.js",
    "docs:watch": "nodemon --watch src/docs/*.json --exec npm run docs:consolidate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "therapy",
    "mental health",
    "wellness",
    "counseling",
    "support",
    "self-care",
    "mindfulness",
    "emotional health",
    "psychology",
    "resilience"
  ],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.4",
    "mongodb-memory-server": "^11.0.1",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "supertest": "^7.2.2",
    "vitest": "^4.1.4"
  },
  "dependencies": {
    "@arcjet/node": "^1.3.1",
    "@scalar/express-api-reference": "^0.8.24",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.7.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.17.1",
    "mongoose-aggregate-paginate-v2": "^1.1.4",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "peer": "^1.0.2",
    "socket.io": "^4.7.4"
  }
}
